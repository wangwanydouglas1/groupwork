# Digital POS & End-of-Day Reconciliation Ledger

def prompt_quantity(item_name):
    while True:
        try:
            qty = float(input(f"Enter quantity for {item_name} (kg/bunches): "))
            if qty <= 0:
                print("Error: Quantity must exceed 0.0")
            else:
                return qty
        except:
            print("Error: Please enter a valid number.")


def calculate_item_price(item_type, quantity, customer_type='retail'):
    prices = {
        "tomatoes": 3000,
        "onions": 2500,
        "matooke": 25000
    }

    wholesale_prices = {
        "tomatoes": 2400,
        "onions": 2000,
        "matooke": 20000
    }

    # Wholesale pricing
    if customer_type == "wholesale":
        if item_type == "matooke" and quantity < 3:
            return quantity * prices[item_type]
        return quantity * wholesale_prices[item_type]

    # Retail pricing with discount
    price = prices[item_type]
    if item_type in ["tomatoes", "onions"] and quantity > 5:
        normal = 5 * price
        extra = (quantity - 5) * price * 0.95
        return normal + extra
    else:
        return quantity * price


def apply_market_levy_and_packaging(subtotal, needs_eco_crate=False):
    levy = subtotal * 0.01
    total = subtotal + levy
    if needs_eco_crate:
        total += 5000
    return total, levy


# Main Program
total_customers = 0
total_revenue = 0
top_customer = ""
top_amount = 0

print("="*50)
print(" MAMA MBOGA DIGITAL STALL POS ")
print("="*50)

while True:
    name = input("Customer Name: ")
    customer_type = input("Customer Type (retail/wholesale): ").lower()

    basket = []
    subtotal = 0

    while True:
        item = input("Add Item (tomatoes/onions/matooke/done): ").lower()
        if item == "done":
            break
        if item not in ["tomatoes", "onions", "matooke"]:
            print("Invalid item.")
            continue

        qty = prompt_quantity(item)
        price = calculate_item_price(item, qty, customer_type)
        basket.append((item, qty, price))
        subtotal += price
        print(f"-> Added {qty} of {item}")

    crate = input("Add reusable delivery crate? (yes/no): ").lower() == "yes"

    total, levy = apply_market_levy_and_packaging(subtotal, crate)

    # Receipt
    print("-"*50)
    print(f"Customer: {name.upper()} ({customer_type.upper()})")
    print("-"*50)
    for item, qty, price in basket:
        print(f"{qty} x {item} = {price:.0f} UGX")
    print("-"*50)
    print(f"Subtotal: {subtotal:.0f} UGX")
    if crate:
        print("Reusable Crate Deposit: 5000 UGX")
    print(f"Market Levy (1%): {levy:.0f} UGX")
    print("-"*50)
    print(f"TOTAL DUE: {total:.0f} UGX")
    print("="*50)

    total_customers += 1
    total_revenue += total

    if total > top_amount:
        top_amount = total
        top_customer = name

    cont = input("Serve next customer? (yes/no): ").lower()
    if cont != "yes":
        break

# End of Day Report
print("="*50)
print(" DAILY MARKET CLOSE ")
print("="*50)
print(f"Total Customers Served: {total_customers}")
print(f"Total Revenue: {total_revenue:.0f} UGX")
print(f"Top Customer: {top_customer} ({top_amount:.0f} UGX)")
print("="*50)